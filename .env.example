# Bedrock model used by both agents. Any Bedrock-hosted Claude model works;
# check which ids are enabled in your account and region before running --live.
# If Opus is not enabled for you, global.anthropic.claude-sonnet-4-6 also works.
PANTRYRELAY_MODEL_ID=global.anthropic.claude-opus-5

# Region your Bedrock model access is enabled in.
AWS_REGION=us-west-2

# Credentials come from the standard AWS chain (aws configure, SSO, or an
# instance role). Do not put keys in this file.
